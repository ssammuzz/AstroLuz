{{ 'astroglo-phase1.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="astroglo-phase1 astroglo-faq">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="astroglo-faq__header">
      {%- if section.settings.label != blank -%}
        <p class="astroglo-section-label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <h2 class="astroglo-section-heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="astroglo-faq__list">
      {%- for block in section.blocks -%}
        <details class="astroglo-faq__item" {{ block.shopify_attributes }}>
          <summary class="astroglo-faq__summary">{{ block.settings.question | escape }}</summary>
          <p class="astroglo-faq__answer">{{ block.settings.answer | escape }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AstroLuz FAQ",
  "tag": "section",
  "class": "astroglo-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Etiqueta",
      "default": "FAQ"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Preguntas frecuentes"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 32,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacio superior",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 32,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacio inferior",
      "default": 68
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Cuándo pago?"
        },
        {
          "type": "text",
          "id": "answer",
          "label": "Respuesta",
          "default": "Pagas al recibir tu pedido."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AstroLuz FAQ",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
